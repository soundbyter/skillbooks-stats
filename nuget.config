<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub Packages requires a token to READ packages too, not just publish them (unlike
  nuget.org). GITHUB_TOKEN is read from an environment variable rather than stored here,
  so nothing secret ends up committed. Set it before building, e.g. in PowerShell:

    $env:GITHUB_TOKEN = gh auth token

  The token needs at least the read:packages scope.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-skillbooks" value="https://nuget.pkg.github.com/soundbyter/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-skillbooks>
      <add key="Username" value="soundbyter" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-skillbooks>
  </packageSourceCredentials>
</configuration>
